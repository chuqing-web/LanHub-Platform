<Application x:Class="ArenaDuel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- 朱墨印刷风：墨底 + 朱红，无描金光晕 -->
    <SolidColorBrush x:Key="BgBrush" Color="#141414"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#EDE8E0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C41E3A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDE8E0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A8680"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="HpBrush" Color="#C41E3A"/>
    <SolidColorBrush x:Key="MpBrush" Color="#4A6FA5"/>
    <FontFamily x:Key="TitleFont">KaiTi, STKaiti, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="BodyFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <Style x:Key="FlatBtn" TargetType="Button">
      <Setter Property="Background" Value="#C41E3A"/>
      <Setter Property="Foreground" Value="#EDE8E0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#A01830"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
