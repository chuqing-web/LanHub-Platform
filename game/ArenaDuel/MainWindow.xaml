<Window x:Class="ArenaDuel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绯刃乱斗"
        Icon="pack://application:,,,/icon/app.ico"
        Width="1180" Height="780"
        MinWidth="1000" MinHeight="680"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 顶栏：印刷刊头 -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3" Padding="20,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Border Width="4" Background="{StaticResource AccentBrush}" Margin="0,2,12,2"/>
          <TextBlock Text="绯刃乱斗" FontSize="28" FontWeight="Bold"
                     Foreground="{StaticResource PaperBrush}" FontFamily="{StaticResource TitleFont}"/>
          <TextBlock Text="  1v1" FontSize="13" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Bottom" Margin="0,0,0,4" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="…" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" Margin="24,0,0,0" TextWrapping="Wrap" FontSize="12"/>
      </DockPanel>
    </Border>

    <!-- Lobby -->
    <Grid x:Name="LobbyPanel" Grid.Row="1" Background="#121212">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="0.9*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#0E0E0E" Margin="0">
        <Grid>
          <Rectangle Fill="#C41E3A" Opacity="0.08" Width="180" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Center" Margin="48,0,32,0">
            <TextBlock Text="对阵开始前" FontSize="13" Foreground="{StaticResource AccentBrush}"
                       FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>
            <TextBlock Text="绯刃乱斗" FontSize="56" FontWeight="Bold" Foreground="{StaticResource PaperBrush}"
                       FontFamily="{StaticResource TitleFont}" LineHeight="64"/>
            <TextBlock Text="局域网双人即时对战。选人互不可见，场地每局随机。"
                       Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,16,0,0"
                       TextWrapping="Wrap" MaxWidth="360"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,48,0">
        <Button Style="{StaticResource FlatBtn}" Content="本地试炼" Click="BtnLocal_Click"
                Height="48" FontSize="16" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="LobbyHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Margin="0,16,0,0" FontSize="13" LineHeight="20"/>
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,12,0,0">
          <TextBlock Text="联机：LanHub 登记本程序 · GameId = arena-duel"
                     Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Pick -->
    <Grid x:Name="PickPanel" Grid.Row="1" Visibility="Collapsed" Background="#121212">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
        <DockPanel>
          <TextBlock Text="盲选" FontSize="22" FontFamily="{StaticResource TitleFont}" FontWeight="Bold"
                     Foreground="{StaticResource PaperBrush}"/>
          <TextBlock Text="对方看不到你的选择" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,16">
        <StackPanel x:Name="CharStrip" Orientation="Horizontal" HorizontalAlignment="Center"/>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
        <Button x:Name="BtnReady" Style="{StaticResource FlatBtn}" Content="准备就绪" Width="200" Height="44"
                Click="BtnReady_Click" FontSize="15" HorizontalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- Battle -->
    <Grid x:Name="BattlePanel" Grid.Row="1" Visibility="Collapsed" Background="#0A0A0A">
      <Grid.RowDefinitions>
        <RowDefinition Height="84"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="64" Height="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Background="#0A0A0A" Margin="0,0,10,0">
            <Image x:Name="PortraitA" Stretch="UniformToFill"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <DockPanel>
              <TextBlock x:Name="HudNameA" Foreground="{StaticResource PaperBrush}" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock x:Name="HudHpTextA" Foreground="{StaticResource MutedBrush}" FontSize="11"
                         FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Height="14" Background="#2A1518" BorderBrush="#4A2028" BorderThickness="1" Margin="0,4,0,0">
              <Grid>
                <Rectangle x:Name="HpGhostA" HorizontalAlignment="Left" Fill="#66402028"/>
                <Rectangle x:Name="HpFillA" HorizontalAlignment="Left" Fill="{StaticResource HpBrush}"/>
              </Grid>
            </Border>
            <Border Height="7" Background="#151820" BorderBrush="#2A3040" BorderThickness="1" Margin="0,3,0,0">
              <Rectangle x:Name="MpFillA" HorizontalAlignment="Left" Fill="{StaticResource MpBrush}"/>
            </Border>
          </StackPanel>

          <Border Grid.Column="2" Width="64" Height="64" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                  Background="#0A0A0A" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TimerText" Text="2:00" FontSize="18" FontWeight="Bold"
                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource PaperBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
            <DockPanel>
              <TextBlock x:Name="HudHpTextB" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
              <TextBlock x:Name="HudNameB" Foreground="{StaticResource PaperBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Height="14" Background="#2A1518" BorderBrush="#4A2028" BorderThickness="1" Margin="0,4,0,0">
              <Grid>
                <Rectangle x:Name="HpGhostB" HorizontalAlignment="Right" Fill="#66402028"/>
                <Rectangle x:Name="HpFillB" HorizontalAlignment="Right" Fill="{StaticResource HpBrush}"/>
              </Grid>
            </Border>
            <Border Height="7" Background="#151820" BorderBrush="#2A3040" BorderThickness="1" Margin="0,3,0,0">
              <Rectangle x:Name="MpFillB" HorizontalAlignment="Right" Fill="{StaticResource MpBrush}"/>
            </Border>
          </StackPanel>

          <Border Grid.Column="4" Width="64" Height="64" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Background="#0A0A0A" Margin="10,0,0,0">
            <Image x:Name="PortraitB" Stretch="UniformToFill"/>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1" Margin="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Canvas x:Name="BattleCanvas" ClipToBounds="True" Background="#080808"
                MouseMove="BattleCanvas_MouseMove"
                MouseLeftButtonDown="BattleCanvas_MouseLeftButtonDown"/>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6">
        <DockPanel>
          <TextBlock x:Name="ArenaLabel" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"
                     VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="CdQ" Width="100" Height="42" Margin="3" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="#181818">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Q" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtQ" Text="—" Foreground="{StaticResource PaperBrush}" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border x:Name="CdE" Width="100" Height="42" Margin="3" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="#181818">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="E" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtE" Text="—" Foreground="{StaticResource PaperBrush}" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border x:Name="CdC" Width="120" Height="42" Margin="3" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}" Background="#1A1012">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="C" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtC" Text="—" Foreground="{StaticResource PaperBrush}" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <TextBlock Text="WASD · 鼠标瞄向 · 左键/J 普攻" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Result -->
    <Grid x:Name="ResultPanel" Grid.Row="1" Visibility="Collapsed" Background="#D0141414">
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,4,0,0"
              Padding="48,40" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
        <StackPanel>
          <TextBlock x:Name="ResultTitle" Text="终局" FontSize="42" FontWeight="Bold"
                     Foreground="{StaticResource PaperBrush}" HorizontalAlignment="Center"
                     FontFamily="{StaticResource TitleFont}"/>
          <TextBlock x:Name="ResultDetail" Foreground="{StaticResource MutedBrush}" FontSize="14"
                     Margin="0,12,0,28" TextAlignment="Center" LineHeight="22"/>
          <Button Style="{StaticResource FlatBtn}" Content="再战" Width="160" Height="42"
                  Click="BtnRematch_Click" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
