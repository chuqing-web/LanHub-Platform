<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LanChat</RootNamespace>
    <AssemblyName>LanChat</AssemblyName>
    <ApplicationIcon>icon\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LanHub.Sdk\LanHub.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lanhub.game.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
