<Window x:Class="LanChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanChat"
        Title="LanChat"
        Icon="pack://application:,,,/icon/app.ico"
        Width="980" Height="680"
        MinWidth="820" MinHeight="520"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type local:ChatLine}">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Bubble"
                Grid.Column="0"
                MaxWidth="440"
                Padding="0"
                HorizontalAlignment="Left"
                Background="{StaticResource BubbleThem}"
                BorderBrush="#D0D5DA"
                BorderThickness="1">
          <DockPanel>
            <Border x:Name="AccentBar" DockPanel.Dock="Left" Width="3" Background="#8A949E"/>
            <StackPanel Margin="10,8,12,8">
              <DockPanel>
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource Accent}"/>
                <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" Margin="12,0,0,0"
                           FontFamily="{StaticResource MonoFont}"/>
              </DockPanel>
              <TextBlock Text="{Binding KindTag}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Foreground="{StaticResource Text}" FontSize="14" LineHeight="22"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMine}" Value="True">
          <Setter TargetName="Bubble" Property="Grid.Column" Value="1"/>
          <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BubbleMe}"/>
          <Setter TargetName="Bubble" Property="BorderBrush" Value="#B8CADA"/>
          <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource Accent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter TargetName="Bubble" Property="Grid.ColumnSpan" Value="2"/>
          <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
          <Setter TargetName="Bubble" Property="Background" Value="#EEF0F2"/>
          <Setter TargetName="Bubble" Property="MaxWidth" Value="520"/>
          <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentHot}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 侧栏：炭色电台面板 -->
    <Border Grid.Column="0" Background="{StaticResource Side}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,8">
          <TextBlock Text="LANCHAT" FontSize="11" Foreground="{StaticResource MutedOnDark}"
                     FontFamily="{StaticResource MonoFont}"/>
          <TextBlock Text="局域网通讯" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource TextOnDark}" Margin="0,4,0,12"/>
          <Border Background="{StaticResource Side2}" BorderBrush="#4A545E" BorderThickness="1" Padding="10,8">
            <StackPanel>
              <TextBlock x:Name="ConnLabel" Text="…" FontWeight="SemiBold" FontSize="13"
                         Foreground="{StaticResource TextOnDark}"/>
              <TextBlock x:Name="StatusLabel" Text="…" Foreground="{StaticResource MutedOnDark}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
          <Button x:Name="BtnRetry" Style="{StaticResource SideBtn}" Content="重试连接"
                  Click="BtnRetry_Click" Margin="0,0,0,6" Visibility="Collapsed"/>
          <Button Style="{StaticResource SideBtn}" Content="房间群聊" Click="BtnRoom_Click" Margin="0,0,0,6"/>
          <Button Style="{StaticResource SideBtn}" Content="本地预览" Click="BtnLocal_Click"/>
        </StackPanel>

        <DockPanel Margin="12,8,12,8">
          <TextBlock DockPanel.Dock="Top" Text="成员 · 双击私信" Foreground="{StaticResource MutedOnDark}"
                     FontSize="11" Margin="2,0,0,8" FontFamily="{StaticResource MonoFont}"/>
          <ListBox x:Name="PeerList" Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource TextOnDark}"
                   MouseDoubleClick="PeerList_MouseDoubleClick"
                   DisplayMemberPath="Label">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,7"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#353D45"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#3D4A56"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- 主区：浅色纸面 -->
    <Grid Grid.Column="1" Background="{StaticResource Panel}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12" Background="#FBFBFC">
        <DockPanel>
          <Border Width="3" Background="{StaticResource Accent}" Margin="0,2,10,2"/>
          <TextBlock x:Name="DmHintText" Text="当前：房间群聊" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
          <TextBlock Text="Enter 发送" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                     FontFamily="{StaticResource MonoFont}"/>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="MsgScroll" Grid.Row="1" Padding="20,12" VerticalScrollBarVisibility="Auto"
                    Background="{StaticResource Bg}">
        <ItemsControl x:Name="MsgList"/>
      </ScrollViewer>

      <TextBlock x:Name="TypingText" Grid.Row="2" Margin="22,0,22,4"
                 Foreground="{StaticResource Muted}" FontSize="12"/>

      <Border Grid.Row="3" Background="#FBFBFC" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="发送" Width="84" Height="38" Margin="10,0,0,0"
                  Click="BtnSend_Click" FontWeight="SemiBold" Cursor="Hand"
                  Background="{StaticResource Accent}" Foreground="White" BorderThickness="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="12,0">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBox x:Name="InputBox" Height="38" VerticalContentAlignment="Center" Padding="10,0"
                   Background="White" Foreground="{StaticResource Text}"
                   BorderBrush="{StaticResource Line}" BorderThickness="1"
                   CaretBrush="{StaticResource Accent}"
                   KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
