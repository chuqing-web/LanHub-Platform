<Window x:Class="LanHub.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑游戏" Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1A222C" Foreground="#E7ECF1"
        ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="LblTitle" Text="标题"/>
    <TextBox x:Name="TxtTitle" Grid.Row="0" Margin="0,22,0,12"/>
    <TextBlock x:Name="LblGameId" Grid.Row="1" Text="GameId"/>
    <TextBox x:Name="TxtGameId" Grid.Row="1" Margin="0,22,0,12"/>
    <TextBlock x:Name="LblExe" Grid.Row="2" Text="Exe 路径"/>
    <DockPanel Grid.Row="2" Margin="0,22,0,12">
      <Button x:Name="BtnBrowse" Content="浏览" Width="72" Click="Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <TextBox x:Name="TxtPath"/>
    </DockPanel>
    <TextBlock x:Name="LblArgs" Grid.Row="3" Text="启动参数"/>
    <TextBox x:Name="TxtArgs" Grid.Row="3" Margin="0,22,0,12"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnCancel" Content="取消" Width="88" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button x:Name="BtnSave" Content="保存" Width="88" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
